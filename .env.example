# Local development only. Keep the real key in .env (ignored by Git).
BERGET_API_KEY=
BERGET_BASE_URL=https://api.berget.ai/v1
BERGET_MODEL=mistralai/Mistral-Small-3.2-24B-Instruct-2506
# EUR per million tokens; snapshot 2026-11-05. Update with your model.
BERGET_INPUT_EUR_PER_MILLION=0.30
BERGET_OUTPUT_EUR_PER_MILLION=0.30
WISP_API_PORT=8090
WISP_DB_PORT=55471
# Optional authorized public game-data ingestion. Never put these in a client bundle.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=eu
BLIZZARD_LOCALE=en_GB

# Friend-test mode: use approved current quest context; no ForeverDB dependency.
FOREVERDB_ENABLED=false
WISP_QUESTLOG_ONLY=true
